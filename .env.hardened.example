# Hardened ZCode capability gates.
# Everything below is opt-in. Leave unset/0 unless you intentionally need it.

ZCODE_ENABLE_TELEMETRY=0
ZCODE_MODEL_TELEMETRY_ENABLED=0
ZCODE_ENABLE_BASH=0
ZCODE_ENABLE_MCP=0
ZCODE_ENABLE_HOOKS=0

# Telemetry endpoints are inert unless their matching opt-in above is enabled.
ZCODE_TELEMETRY_REPORT_ENDPOINT=
ZCODE_ARMS_RUM_ENDPOINT=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Prefer a custom Provider for a controlled endpoint.
# Example:
#   API format: OpenAI-compatible
#   Base URL:   http://127.0.0.1:8000/v1
#
# Do not put real secrets in a tracked file.
